# =============================================
# PerformIQ - Environment Configuration
# =============================================
# Copy this file to .env and update values.
# NEVER commit .env to version control.

# --- PostgreSQL ---
POSTGRES_DB=performiq_db
POSTGRES_USER=performiq_user
POSTGRES_PASSWORD=performiq_pass
POSTGRES_PORT=5432

# --- pgAdmin (optional, use with: docker compose --profile tools up) ---
PGADMIN_EMAIL=admin@performiq.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Spring Boot ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/performiq_db
SPRING_DATASOURCE_USERNAME=performiq_user
SPRING_DATASOURCE_PASSWORD=performiq_pass

# --- JWT ---
JWT_SECRET=performiq-dev-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# --- Data Import ---
DATA_IMPORT_DIR=../data-generator/output
